{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Neutral contract review request",
  "type": "object",
  "additionalProperties": false,
  "required": ["requestId", "ticketId", "targetRepository", "reviewKind", "reviewSubject", "neutralQuestion", "sources", "stage1"],
  "properties": {
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,80}$" },
    "ticketId": { "type": "string", "pattern": "^gw-[A-Za-z0-9.-]+$", "description": "Opaque coordinator correlation only; excluded from every role prompt." },
    "targetRepository": { "type": "string" },
    "reviewKind": { "enum": ["decision", "stage1"] },
    "reviewSubject": { "type": "string", "minLength": 1 },
    "neutralQuestion": { "type": "string", "minLength": 1 },
    "sources": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "stage1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "sourceContract"],
      "properties": {
        "enabled": { "type": "boolean" },
        "sourceContract": { "type": ["string", "null"] }
      }
    }
  }
}
