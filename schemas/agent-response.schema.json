{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Contract review role response",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "reason", "findings", "classifications", "proofs", "resolutions", "unresolved", "stage1Manifest"],
  "properties": {
    "status": { "enum": ["ok", "blocker"] },
    "reason": { "type": ["string", "null"] },
    "findings": { "type": "array", "items": { "$ref": "#/definitions/finding" } },
    "classifications": { "type": "array", "items": { "$ref": "#/definitions/comparison" } },
    "proofs": { "type": "array", "items": { "$ref": "#/definitions/proof" } },
    "resolutions": { "type": "array", "items": { "$ref": "#/definitions/resolution" } },
    "unresolved": { "type": "array", "items": { "$ref": "#/definitions/unresolved" } },
    "stage1Manifest": { "type": "array", "items": { "$ref": "#/definitions/stage1" } }
  },
  "definitions": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "locator", "excerpt"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 },
        "excerpt": { "type": "string", "minLength": 1 }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "destinations", "existingTag", "proposedTags", "rationale"],
      "properties": {
        "disposition": { "enum": ["MOVE", "SPLIT", "PHASE-2", "NO_CHANGE", "NOT_APPLICABLE"] },
        "destinations": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "existingTag": { "type": ["string", "null"] },
        "proposedTags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "claim", "evidence", "classification", "placement"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "claim": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/evidence" } },
        "classification": { "enum": ["fact", "judgment"] },
        "placement": { "$ref": "#/definitions/placement" }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "classification", "statement", "reviewerAFindingIds", "reviewerBFindingIds", "evidence", "rationale"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "classification": { "enum": ["AGREED", "RESOLVED_BY_READING", "ONE_SIDED", "NEEDS_PROOF", "USER_DECISION"] },
        "statement": { "type": "string", "minLength": 1 },
        "reviewerAFindingIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "reviewerBFindingIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/evidence" } },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classificationId", "findingIds", "position", "evidence", "rationale"],
      "properties": {
        "classificationId": { "type": "string", "minLength": 1 },
        "findingIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "position": { "enum": ["CONFIRM", "WITHDRAW", "QUALIFY", "USER_DECISION"] },
        "evidence": { "type": "array", "items": { "$ref": "#/definitions/evidence" } },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classificationId", "outcome", "acceptedFindingIds", "evidence", "rationale"],
      "properties": {
        "classificationId": { "type": "string", "minLength": 1 },
        "outcome": { "enum": ["ACCEPT_A", "ACCEPT_B", "ACCEPT_BOTH", "REJECT_BOTH", "USER_DECISION"] },
        "acceptedFindingIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/evidence" } },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "unresolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reason", "options"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "options": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "stage1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "destinations", "name", "disposition", "perDestinationNames"],
      "properties": {
        "start": { "type": "integer", "minimum": 1 },
        "end": { "type": "integer", "minimum": 1 },
        "destinations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "name": { "type": "string", "minLength": 1 },
        "disposition": { "enum": ["MOVE", "SPLIT", "PHASE-2"] },
        "perDestinationNames": { "type": ["array", "null"], "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
